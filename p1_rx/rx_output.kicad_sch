	(text "U802 LM74700 + Q801 ideal diode: source on CHG_OUT, drain on VSCAP. Blocks supercap back-feed through the Buck upper-FET body diode when the car leaves (see docs/design.md)."
		(exclude_from_sim no)
		(at 20.32 128.27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2981956a-7748-4c3e-93ce-f879c10e049a")
	)
	(text "VSCAP_SNS = VSCAP x 10k / 160k (24 V -> 1.5 V)."
		(exclude_from_sim no)
		(at 20.32 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "36b5cc1c-51bf-410c-82c8-44dec85d7874")
	)
	(text "R801 2 mOhm + U801 INA240A2 (x50): 10 A charge current -> 1.0 V on ISNS_CHG (MCU ADC + COMP1 current limit)."
		(exclude_from_sim no)
		(at 20.32 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8d7d0f68-d97b-4569-93d6-f2984874ee96")
	)
	(text "CHG_EN from RX MCU enables the ideal diode gate drive; 100k pull-down keeps it off while the MCU is unpowered (body diode still conducts forward only)."
		(exclude_from_sim no)
		(at 20.32 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c257cfd8-ce2c-46eb-8b3e-524d9abc22a6")
	)
	(text "Supercap window 6-24 V, 10 F equivalent. D801 SMAJ26A clamps VSCAP. Series-cell balancing is on the supercap bank side, not on this board."
		(exclude_from_sim no)
		(at 20.32 135.89 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e5f704e7-4feb-4a15-a5b4-bf044117bc8b")
	)
