			)
			(justify left bottom)
		)
		(uuid "4b9d9f56-a6ae-4339-ba8c-271d82e95ddc")
	)
	(text "Cf = 1/(w^2 Lf) = 203.6 nF -> C301||C302||C303 = 203.3 nF.  Ct = 1/(w^2 (Lt-Lf)) = 87.3 nF -> C304||C305 = 87.6 nF."
		(exclude_from_sim no)
		(at 20.32 115.57 0)
		(effects
			(font
