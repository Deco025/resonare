	(text "Ideal-model estimate at 24 V full duty: V_AB1 = 21.6 Vrms, I_Lt = V_AB1/(w Lf) = 4.0 Arms, V_Ct = 50 Vrms, V_Lt = 72 Vrms."
		(exclude_from_sim no)
		(at 20.32 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0572ab22-4f0a-4144-b1ea-ff0ee052b65a")
	)
	(text "Resonant caps, 250 V C0G 1812. Cf = C301+C302+C303 = 203 nF: about 37 V rms / 7 A rms; Ct = C304+C305 = 87.6 nF: about 50 V rms / 4 A rms at 120 W. Trim to the measured Lf and Lt."
		(exclude_from_sim no)
		(at 20.32 123.19 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1d1dd4a7-e897-4b60-89f3-1cf854351fe4")
	)
	(text "Cf"
		(exclude_from_sim no)
		(at 53.34 81.28 0)
		(effects
			(font
